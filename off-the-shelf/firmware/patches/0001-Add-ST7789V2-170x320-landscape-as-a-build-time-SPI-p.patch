diff --git a/components/kvm_display/test/test_st7789_ui.c b/components/kvm_display/test/test_st7789_ui.c
new file mode 100644
index 0000000..a70f5da
--- /dev/null
+++ b/components/kvm_display/test/test_st7789_ui.c
@@ -0,0 +1,152 @@
+/*
+ * SPDX-FileCopyrightText: 2026 ESP-KVM contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Run the 320x170 layout on a host. Each scene must keep the strip just inside
+ * the frame empty: a string that overran its column would show up there. With an
+ * output directory as argv[1], each scene is also written as a PPM to look at.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "st7789_ui.h"
+
+#define W ST7789_UI_W
+#define H ST7789_UI_H
+#define STRIP 4 /* the empty band inside the frame, in pixels */
+
+static uint16_t fb[W * H];
+static int failures;
+
+static void write_ppm(const char *dir, const char *name)
+{
+    char path[512];
+    snprintf(path, sizeof(path), "%s/%s.ppm", dir, name);
+    FILE *f = fopen(path, "wb");
+    if (!f) {
+        perror(path);
+        exit(2);
+    }
+    fprintf(f, "P6\n%d %d\n255\n", W, H);
+    for (int i = 0; i < W * H; i++) {
+        const uint16_t v = (uint16_t)((fb[i] >> 8) | (fb[i] << 8));
+        const unsigned char rgb[3] = {(unsigned char)((v >> 8) & 0xF8), (unsigned char)((v >> 3) & 0xFC),
+                                      (unsigned char)((v << 3) & 0xF8)};
+        fwrite(rgb, 1, 3, f);
+    }
+    fclose(f);
+}
+
+static int strip_is_clear(void)
+{
+    const uint16_t bg = fb[(ST7789_UI_FRAME) * W + ST7789_UI_FRAME];
+    const int lo = ST7789_UI_FRAME, hi = ST7789_UI_FRAME + STRIP;
+    for (int y = lo; y < H - lo; y++) {
+        for (int x = lo; x < W - lo; x++) {
+            const int in_strip = x < hi || x >= W - hi || y < hi || y >= H - hi;
+            if (in_strip && fb[y * W + x] != bg) {
+                return 0;
+            }
+        }
+    }
+    return 1;
+}
+
+static void scene(const char *dir, const char *name, int screen, int splash,
+                  const kvm_display_status_t *st)
+{
+    st7789_ui_t ui = {.screen = (uint8_t)screen, .tick = 0, .splash = (uint8_t)splash};
+    memset(fb, 0, sizeof(fb));
+    st7789_ui_render(&ui, fb, st);
+    const int ok = strip_is_clear();
+    printf("  %-22s %s\n", name, ok ? "ok" : "FAIL: ink inside the frame strip");
+    failures += !ok;
+    if (dir) {
+        write_ppm(dir, name);
+    }
+}
+
+static kvm_display_status_t base(void)
+{
+    kvm_display_status_t s;
+    memset(&s, 0, sizeof(s));
+    strcpy(s.hostname, "espkvm");
+    strcpy(s.ip, "192.168.1.123");
+    strcpy(s.link, "Wi-Fi");
+    strcpy(s.ssid, "HomeWiFi");
+    strcpy(s.version, "v.0.77.0-st7789");
+    strcpy(s.codec, "MJPEG");
+    s.video_signal = true;
+    s.hres = 1920;
+    s.vres = 1080;
+    s.fps = 9;
+    s.temp_c = 52;
+    s.psram_kb = 19000;
+    s.psram_total_kb = 32000;
+    s.notice_pct = -1;
+    return s;
+}
+
+int main(int argc, char **argv)
+{
+    const char *dir = argc > 1 ? argv[1] : NULL;
+    kvm_display_status_t s = base();
+
+    scene(dir, "01_splash_version", 0, ST7789_UI_SPLASH_TICKS, &s);
+    scene(dir, "02_splash_logo", 0, ST7789_UI_SPLASH_TICKS / 2, &s);
+    scene(dir, "03_network", 0, 0, &s);
+
+    strcpy(s.ip, "255.255.255.255");
+    strcpy(s.hostname, "a-very-long-host-name-for-a-kvm");
+    strcpy(s.ssid, "a-thirty-two-char-wifi-name-here");
+    strcpy(s.ts_ip, "100.100.100.100");
+    scene(dir, "04_network_longest", 0, 0, &s);
+
+    s = base();
+    s.ip[0] = '\0';
+    s.video_signal = false;
+    scene(dir, "05_network_no_link", 0, 0, &s);
+
+    s = base();
+    s.ap_mode = true;
+    strcpy(s.link, "AP mode");
+    strcpy(s.ip, "192.168.4.1");
+    strcpy(s.ssid, "ESP-KVM-A1B2");
+    strcpy(s.join_qr, "WIFI:T:nopass;S:ESP-KVM-A1B2;;");
+    scene(dir, "06_ap_qr_open", 0, 0, &s);
+
+    strcpy(s.ssid, "a-thirty-two-char-wifi-name-here");
+    strcpy(s.ap_pass, "correct-horse-battery-staple-correct-horse-battery-staple-12345");
+    snprintf(s.join_qr, sizeof(s.join_qr), "WIFI:T:WPA;S:%s;P:%s;;", s.ssid, s.ap_pass);
+    scene(dir, "07_ap_qr_longest", 0, 0, &s);
+
+    s = base();
+    scene(dir, "08_video", 1, 0, &s);
+    strcpy(s.codec, "H.264");
+    s.hres = 3840;
+    s.vres = 2160;
+    s.fps = 120;
+    scene(dir, "09_video_widest", 1, 0, &s);
+    s.video_signal = false;
+    scene(dir, "10_video_no_signal", 1, 0, &s);
+
+    s = base();
+    scene(dir, "11_health", 2, 0, &s);
+    s.temp_c = 88;
+    s.psram_kb = 1000;
+    scene(dir, "12_health_hot", 2, 0, &s);
+
+    s = base();
+    strcpy(s.notice, "RESET PASSWORD");
+    strcpy(s.notice_detail, "keep holding the button");
+    s.notice_pct = 60;
+    scene(dir, "13_notice_progress", 0, 0, &s);
+    strcpy(s.notice, "UPDATE");
+    strcpy(s.notice_detail, "do not power off");
+    s.notice_pct = -1;
+    scene(dir, "14_notice_plain", 0, 0, &s);
+
+    printf(failures ? "st7789 layout: %d failed\n" : "st7789 layout: all ok\n", failures);
+    return failures ? 1 : 0;
+}

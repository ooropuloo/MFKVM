+
         # The panel's five GPIOs stay runtime settings - the operator solders the
         # wires and picks the pins in the console. These only choose what the
         # console offers before anyone touches them, per board, because "free" is
@@ -107,6 +135,12 @@ menu "ESP-KVM"
             range -1 ENV_GPIO_RANGE_MAX
             default 33
 
+        config KVM_DISP_BL_GPIO
+            int "SPI LCD default backlight GPIO (-1 if tied high)"
+            depends on KVM_ENABLE_DISPLAY
+            range -1 ENV_GPIO_RANGE_MAX

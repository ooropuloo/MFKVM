diff --git a/components/kvm_display/test/run.sh b/components/kvm_display/test/run.sh
new file mode 100644
index 0000000..30413d8
--- /dev/null
+++ b/components/kvm_display/test/run.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Run the 320x170 layout on this machine - no device needed. It needs the qrcode
+# component, which an ESP-IDF build of the firmware has fetched. An argument names
+# a directory to write each scene to, as a PPM.
+set -e
+here=$(dirname "$0")
+qr=${QRCODE_DIR:-$here/../../../managed_components/espressif__qrcode}
+if [ ! -f "$qr/qrcodegen.c" ]; then
+    echo "st7789 layout: skipped, no qrcode at $qr (build the firmware once, or set QRCODE_DIR)"
+    exit 0
+fi
+out=$(mktemp -d)
+cc -std=gnu11 -Wall -Wextra -O2 -I "$here/stub" -I "$here/../include" -I "$here/../drivers" \
+   -I "$here/../drivers/st7789" -I "$qr/include" -I "$qr" \
+   "$here/test_st7789_ui.c" "$here/../drivers/st7789/st7789_ui.c" \
+   "$qr/esp_qrcode_main.c" "$qr/esp_qrcode_wrapper.c" "$qr/qrcodegen.c" \
+   -lm -o "$out/test_st7789_ui"
+"$out/test_st7789_ui" "$@"
+rm -rf "$out"

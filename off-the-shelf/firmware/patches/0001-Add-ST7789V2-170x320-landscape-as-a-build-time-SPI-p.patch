diff --git a/components/kvm_display/drivers/st7789/st7789.c b/components/kvm_display/drivers/st7789/st7789.c
new file mode 100644
index 0000000..f533edf
--- /dev/null
+++ b/components/kvm_display/drivers/st7789/st7789.c
@@ -0,0 +1,198 @@
+/*
+ * SPDX-FileCopyrightText: 2026 ESP-KVM contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * ST7789V2 170x320 colour LCD over SPI, in landscape - the Waveshare 1.9" module.
+ * Takes the place of the GC9A01 as disp_type 2 in a build that selects it
+ * (CONFIG_KVM_SPI_PANEL_ST7789_170X320), and uses the same disp_* SPI pin settings.
+ *
+ * NOT RUN ON A PANEL. The gap, the mirror and the colour order below come from the
+ * vendor's example code for this module. The vendor writes MADCTL 0x70; this writes
+ * 0x60 (the ML bit changes only which way the panel refreshes, not the picture).
+ */
+#include "sdkconfig.h"
+
+#if CONFIG_KVM_ENABLE_DISPLAY && CONFIG_KVM_SPI_PANEL_ST7789_170X320
+
+#include <stdlib.h>
+
+#include "driver/gpio.h"
+#include "driver/spi_master.h"
+#include "esp_cache.h"
+#include "esp_heap_caps.h"
+#include "esp_lcd_panel_io.h"
+#include "esp_lcd_panel_ops.h"
+#include "esp_lcd_panel_st7789.h"
+#include "esp_log.h"
+#include "esp_private/esp_cache_private.h"
+
+#include "kvm_display_driver.h"
+#include "kvm_settings.h"
+#include "st7789_ui.h"
+
+#define TAG "st7789"
+
+#define LCD_W ST7789_UI_W
+#define LCD_H ST7789_UI_H
+#define FB_PIXELS (LCD_W * LCD_H)
+/* The controller has 240 columns of RAM and the glass the middle 170. Centred, so
+ * the same gap holds with the picture turned over. */
+#define LCD_GAP_X 0
+#define LCD_GAP_Y 35
+/* Rows per SPI transfer; see flush() in gc9a01.c for why not the whole frame. */
+#define FLUSH_BAND_ROWS 24
+
+typedef struct {
+    esp_lcd_panel_handle_t panel;
+    esp_lcd_panel_io_handle_t io;
+    uint16_t *fb; /* RGB565, byte-swapped for the panel, in PSRAM */
+    int bl;       /* backlight GPIO, -1 if left to the module's own pull-up */
+    st7789_ui_t ui;
+} st7789_ctx_t;
+
+static esp_err_t attach(void **ctx)
+{
+    const int sclk = (int)kvm_setting_int("disp_sclk");
+    const int mosi = (int)kvm_setting_int("disp_mosi");
+    const int cs = (int)kvm_setting_int("disp_cs");
+    const int dc = (int)kvm_setting_int("disp_dc");
+    const int rst = (int)kvm_setting_int("disp_rst");
+    const int bl = (int)kvm_setting_int("disp_bl");
+    if (sclk < 0 || mosi < 0 || cs < 0 || dc < 0) {
+        ESP_LOGW(TAG, "ST7789 needs SCLK, MOSI, CS and DC pins set");
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    st7789_ctx_t *g = calloc(1, sizeof(*g));
+    if (!g) {
+        return ESP_ERR_NO_MEM;
+    }
+    g->bl = bl;
+    g->ui.splash = ST7789_UI_SPLASH_TICKS;
+    /* Cache-aligned, so the SPI driver can DMA straight out of PSRAM. */
+    size_t align = 64;
+    (void)esp_cache_get_alignment(MALLOC_CAP_SPIRAM | MALLOC_CAP_DMA, &align);
+    if (align == 0) {
+        align = 64;
+    }
+    const size_t fb_bytes = ((FB_PIXELS * sizeof(uint16_t)) + align - 1) / align * align;
+    g->fb = heap_caps_aligned_alloc(align, fb_bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_DMA);
+    if (!g->fb) {
+        free(g);
+        return ESP_ERR_NO_MEM;
+    }
+
+    const spi_bus_config_t bus = {
+        .sclk_io_num = sclk,
+        .mosi_io_num = mosi,
+        .miso_io_num = -1,
+        .quadwp_io_num = -1,
+        .quadhd_io_num = -1,
+        .max_transfer_sz = LCD_W * FLUSH_BAND_ROWS * sizeof(uint16_t),
+    };
+    esp_err_t err = spi_bus_initialize(CONFIG_KVM_GC9A01_SPI_HOST, &bus, SPI_DMA_CH_AUTO);
+    if (err != ESP_OK && err != ESP_ERR_INVALID_STATE /* already initialised */) {
+        goto fail_fb;
+    }
+
+    const esp_lcd_panel_io_spi_config_t io_cfg = {
+        .dc_gpio_num = dc,
+        .cs_gpio_num = cs,
+        .pclk_hz = 40 * 1000 * 1000,
+        .lcd_cmd_bits = 8,
+        .lcd_param_bits = 8,
+        .spi_mode = 0,
+        .trans_queue_depth = 10,
+    };
+    err = esp_lcd_new_panel_io_spi((esp_lcd_spi_bus_handle_t)CONFIG_KVM_GC9A01_SPI_HOST, &io_cfg,
+                                   &g->io);
+    if (err != ESP_OK) {
+        goto fail_fb;
+    }
+    const esp_lcd_panel_dev_config_t panel_cfg = {
+        .reset_gpio_num = rst,
+        .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
+        .bits_per_pixel = 16,
+    };
+    err = esp_lcd_new_panel_st7789(g->io, &panel_cfg, &g->panel);
+    if (err != ESP_OK) {
+        goto fail_io;
+    }
+    esp_lcd_panel_reset(g->panel);
+    esp_lcd_panel_init(g->panel);
+    esp_lcd_panel_invert_color(g->panel, true);
+    esp_lcd_panel_swap_xy(g->panel, true);
+    const bool upside_down = kvm_setting_bool("disp_rotate_180");
+    esp_lcd_panel_mirror(g->panel, !upside_down, upside_down);
+    esp_lcd_panel_set_gap(g->panel, LCD_GAP_X, LCD_GAP_Y);
+    esp_lcd_panel_disp_on_off(g->panel, true);
+
+    if (bl >= 0) {
+        const gpio_config_t bl_cfg = {.pin_bit_mask = 1ULL << bl, .mode = GPIO_MODE_OUTPUT};
+        gpio_config(&bl_cfg);
+        gpio_set_level(bl, 1);
+    }
+
+    ESP_LOGI(TAG, "ST7789 up on SPI%d (sclk %d mosi %d cs %d dc %d rst %d bl %d)",
+             CONFIG_KVM_GC9A01_SPI_HOST, sclk, mosi, cs, dc, rst, bl);
+    *ctx = g;
+    return ESP_OK;
+
+fail_io:
+    esp_lcd_panel_io_del(g->io);
+fail_fb:
+    free(g->fb);
+    free(g);
+    return err == ESP_OK ? ESP_FAIL : err;
+}
+
+static esp_err_t flush(st7789_ctx_t *g)
+{
+    for (int y = 0; y < LCD_H; y += FLUSH_BAND_ROWS) {
+        const int rows = (y + FLUSH_BAND_ROWS <= LCD_H) ? FLUSH_BAND_ROWS : (LCD_H - y);
+        const esp_err_t err =
+            esp_lcd_panel_draw_bitmap(g->panel, 0, y, LCD_W, y + rows, g->fb + (size_t)y * LCD_W);
+        if (err != ESP_OK) {
+            return err;
+        }
+    }
+    return ESP_OK;
+}
+
+static esp_err_t render(void *ctx, const kvm_display_status_t *status)
+{
+    st7789_ctx_t *g = ctx;
+    st7789_ui_render(&g->ui, g->fb, status);
+    return flush(g);
+}
+
+static void detach(void *ctx)
+{
+    st7789_ctx_t *g = ctx;
+    if (!g) {
+        return;
+    }
+    if (g->panel) {
+        esp_lcd_panel_disp_on_off(g->panel, false);
+        esp_lcd_panel_del(g->panel);
+    }
+    if (g->io) {
+        esp_lcd_panel_io_del(g->io);
+    }
+    (void)spi_bus_free(CONFIG_KVM_GC9A01_SPI_HOST);
+    if (g->bl >= 0) {
+        gpio_set_level(g->bl, 0);
+    }
+    free(g->fb);
+    free(g);
+}
+
+const kvm_display_driver_t kvm_display_st7789 = {
+    .name = "st7789",
+    .label = "ST7789 170x320 landscape",
+    .attach = attach,
+    .render = render,
+    .detach = detach,
+};
+
+#endif /* CONFIG_KVM_ENABLE_DISPLAY && CONFIG_KVM_SPI_PANEL_ST7789_170X320 */
diff --git a/components/kvm_display/drivers/st7789/st7789_ui.c b/components/kvm_display/drivers/st7789/st7789_ui.c
new file mode 100644
index 0000000..b02e1d0
--- /dev/null
+++ b/components/kvm_display/drivers/st7789/st7789_ui.c
@@ -0,0 +1,307 @@
+/*
+ * SPDX-FileCopyrightText: 2026 ESP-KVM contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * The same three status screens, notice and splash as the round GC9A01, laid out
+ * for a wide rectangle: a coloured frame takes the place of the status ring, a
+ * header row of icon and title sits top left, and a progress bar takes the place
+ * of the gauge on the rim.
+ */
+#include "st7789_ui.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "font5x7.h"
+#include "icons.h"
+#include "logo.h"
+#include "qrcode.h"
+
+#define W ST7789_UI_W
+#define H ST7789_UI_H
+#define MARGIN 12 /* text stays this far from the edge of the glass */
+#define TEXT_W (W - 2 * MARGIN)
+#define GLYPH_W 6 /* 5 columns and a gap, at scale 1 */
+
+#define STATUS_SCREENS 3
+#define SCREEN_DWELL_TICKS 4
+
+#define BG st7789_ui_rgb(8, 10, 14)
+#define WHITE st7789_ui_rgb(235, 238, 245)
+#define GREY st7789_ui_rgb(140, 150, 165)
+#define CYAN st7789_ui_rgb(90, 200, 235)
+#define GREEN st7789_ui_rgb(90, 210, 120)
+#define AMBER st7789_ui_rgb(235, 190, 70)
+#define RED st7789_ui_rgb(235, 100, 90)
+#define TRACK st7789_ui_rgb(38, 42, 50)
+
+static void put_px(uint16_t *fb, int x, int y, uint16_t c)
+{
+    if (x >= 0 && x < W && y >= 0 && y < H) {
+        fb[y * W + x] = c;
+    }
+}
+
+static void fill_rect(uint16_t *fb, int x, int y, int w, int h, uint16_t c)
+{
+    for (int j = 0; j < h; j++) {
+        for (int i = 0; i < w; i++) {
+            put_px(fb, x + i, y + j, c);
+        }
+    }
+}
+
+/* Clear to the background inside a frame of colour @p c. */
+static void background(uint16_t *fb, uint16_t c)
+{
+    fill_rect(fb, 0, 0, W, H, c);
+    fill_rect(fb, ST7789_UI_FRAME, ST7789_UI_FRAME, W - 2 * ST7789_UI_FRAME,
+              H - 2 * ST7789_UI_FRAME, BG);
+}
+
+static void bar(uint16_t *fb, int y, int h, float frac, uint16_t fg)
+{
+    if (frac < 0) {
+        frac = 0;
+    } else if (frac > 1) {
+        frac = 1;
+    }
+    fill_rect(fb, MARGIN, y, TEXT_W, h, TRACK);
+    fill_rect(fb, MARGIN, y, (int)(TEXT_W * frac + 0.5f), h, fg);
+}
+
+static void draw_char(uint16_t *fb, int x, int y, char ch, int s, uint16_t c)
+{
+    const unsigned char u = (unsigned char)ch; /* char is signed on a host */
+    const uint8_t *g = font5x7[(u < 0x20 || u > 0x7F) ? 0 : (u - 0x20)];
+    for (int col = 0; col < 5; col++) {
+        for (int row = 0; row < 7; row++) {
+            if (g[col] & (1 << row)) {
+                fill_rect(fb, x + col * s, y + row * s, s, s, c);
+            }
+        }
+    }
+}
+
+static void draw_icon(uint16_t *fb, int x, int y, const uint8_t g[8], int s, uint16_t c)
+{
+    for (int col = 0; col < 8; col++) {
+        for (int row = 0; row < 8; row++) {
+            if (g[col] & (1u << row)) {
+                fill_rect(fb, x + col * s, y + row * s, s, s, c);
+            }
+        }
+    }
+}
+
+/* The largest scale, up to @p max_s, at which @p str fits @p max_w. Never below 1. */
+static int scale_for(const char *str, int max_w, int max_s)
+{
+    /* Without the gap after the last glyph: it is not ink. */
+    const int cols = (int)strlen(str) * GLYPH_W - 1;
+    for (int s = max_s; s > 1; s--) {
+        if (cols * s <= max_w) {
+            return s;
+        }
+    }
+    return 1;
+}
+
+/* Left-aligned text in a column @p max_w wide. A string too long even at scale 1
+ * is cut at the column rather than left to run into whatever is beside it. */
+static void text_left(uint16_t *fb, int x, int y, const char *str, int max_w, int max_s, uint16_t c)
+{
+    const int s = scale_for(str, max_w, max_s);
+    const int glyph = GLYPH_W * s;
+    for (const char *p = str; *p && 5 * s <= max_w; p++, x += glyph, max_w -= glyph) {
+        draw_char(fb, x, y, *p, s, c);
+    }
+}
+
+static void text_centered(uint16_t *fb, int y, const char *str, int max_s, uint16_t c)
+{
+    const int s = scale_for(str, TEXT_W, max_s);
+    const int ink = (int)strlen(str) * GLYPH_W * s - s;
+    text_left(fb, ink < TEXT_W ? (W - ink) / 2 : MARGIN, y, str, TEXT_W, s, c);
+}
+
+static void header(uint16_t *fb, const uint8_t icon[8], const char *title)
+{
+    draw_icon(fb, MARGIN, MARGIN, icon, 3, CYAN);
+    text_left(fb, MARGIN + 32, MARGIN + 2, title, TEXT_W - 32, 3, CYAN);
+}
+
+static void render_splash(st7789_ui_t *ui, uint16_t *fb, const kvm_display_status_t *st)
+{
+    background(fb, CYAN);
+    if (ui->splash > ST7789_UI_SPLASH_TICKS / 2) {
+        text_centered(fb, 50, "ESP-KVM", 5, WHITE);
+        text_centered(fb, 106, st->version, 2, GREY);
+    } else {
+        const int s = 12;
+        const int x0 = (W - LOGO_COLS * s) / 2, y0 = (H - LOGO_ROWS * s) / 2;
+        for (int row = 0; row < LOGO_ROWS; row++) {
+            for (int col = 0; col < LOGO_COLS; col++) {
+                if (logo_px(col, row)) {
+                    fill_rect(fb, x0 + col * s, y0 + row * s, s, s, st7789_ui_rgb(230, 237, 243));
+                }
+            }
+        }
+    }
+}
+
+/*
+ * The hotspot's join code. Dark on light with its four-module quiet zone, in whole
+ * pixels per module, for the reasons given at the same code in gc9a01.c.
+ */
+#define QR_QUIET 4
+#define QR_BOX 154 /* the glass height, less the frame and a gap */
+#define QR_X 8
+
+typedef struct {
+    uint16_t *fb;
+    int side;
+} qr_paint_t;
+
+static void qr_paint(esp_qrcode_handle_t qr, void *user_data)
+{
+    qr_paint_t *p = (qr_paint_t *)user_data;
+    const int modules = esp_qrcode_get_size(qr);
+    const int total = modules + 2 * QR_QUIET;
+    const int scale = QR_BOX / total;
+    if (scale < 1) {
+        return;
+    }
+    const int side = total * scale;
+    const int y0 = (H - side) / 2;
+    fill_rect(p->fb, QR_X, y0, side, side, st7789_ui_rgb(255, 255, 255));
+    for (int y = 0; y < modules; y++) {
+        for (int x = 0; x < modules; x++) {
+            if (esp_qrcode_get_module(qr, x, y)) {
+                fill_rect(p->fb, QR_X + (QR_QUIET + x) * scale, y0 + (QR_QUIET + y) * scale, scale,
+                          scale, st7789_ui_rgb(0, 0, 0));
+            }
+        }
+    }
+    p->side = side;
+}
+
+static int draw_join_qr(uint16_t *fb, const char *payload)
+{
+    qr_paint_t paint = {.fb = fb, .side = 0};
+    esp_qrcode_config_t cfg = ESP_QRCODE_CONFIG_DEFAULT();
+    cfg.display_func_with_cb = qr_paint;
+    cfg.user_data = &paint;
+    cfg.max_qrcode_version = 6; /* 41 modules, 3 px each; see gc9a01.c */
+    cfg.qrcode_ecc_level = ESP_QRCODE_ECC_LOW;
+    return esp_qrcode_generate(&cfg, payload) == ESP_OK ? paint.side : 0;
+}
+
+static void render_notice(uint16_t *fb, const kvm_display_status_t *st)
+{
+    background(fb, CYAN);
+    text_centered(fb, 40, st->notice, 4, WHITE);
+    text_centered(fb, 88, st->notice_detail, 2, GREY);
+    if (st->notice_pct >= 0) {
+        bar(fb, 122, 20, st->notice_pct / 100.0f, CYAN);
+    }
+}
+
+static void render_network(uint16_t *fb, const kvm_display_status_t *st)
+{
+    char buf[48];
+
+    if (st->ap_mode && st->join_qr[0]) {
+        const int side = draw_join_qr(fb, st->join_qr);
+        if (side > 0) {
+            const int x = QR_X + side + 8;
+            const int w = W - MARGIN - x + 4; /* the frame is the limit on this side */
+            text_left(fb, x, 24, "SCAN TO JOIN", w, 2, CYAN);
+            text_left(fb, x, 52, st->ssid, w, 2, WHITE);
+            text_left(fb, x, 80, "192.168.4.1", w, 2, GREY);
+            if (st->ap_pass[0]) {
+                text_left(fb, x, 108, st->ap_pass, w, 2, GREY);
+            }
+            return;
+        }
+    }
+
+    header(fb, icon_net, st->ap_mode ? "AP RESCUE" : "NETWORK");
+    text_left(fb, MARGIN, 50, st->ip[0] ? st->ip : "no link", TEXT_W, 4, WHITE);
+    if (st->ap_mode) {
+        text_left(fb, MARGIN, 88, "192.168.4.1", TEXT_W, 2, GREY);
+        text_left(fb, MARGIN, 110, st->ssid, TEXT_W, 2, GREY);
+        return;
+    }
+    snprintf(buf, sizeof(buf), "%s.local", st->hostname);
+    text_left(fb, MARGIN, 88, buf, TEXT_W, 2, GREY);
+    snprintf(buf, sizeof(buf), "%s %s", st->link, st->ssid);
+    text_left(fb, MARGIN, 110, buf, TEXT_W, 2, GREY);
+    if (st->ts_ip[0]) {
+        snprintf(buf, sizeof(buf), "TS %s", st->ts_ip);
+        text_left(fb, MARGIN, 132, buf, TEXT_W, 2, GREEN);
+    }
+}
+
+static void render_video(uint16_t *fb, const kvm_display_status_t *st)
+{
+    char buf[40];
+
+    header(fb, icon_video, "VIDEO");
+    if (!st->video_signal) {
+        text_left(fb, MARGIN, 76, "NO SIGNAL", TEXT_W, 4, RED);
+        return;
+    }
+    snprintf(buf, sizeof(buf), "%ux%u", (unsigned)st->hres, (unsigned)st->vres);
+    text_left(fb, MARGIN, 56, buf, TEXT_W, 4, WHITE);
+    snprintf(buf, sizeof(buf), "%u fps  %s", (unsigned)st->fps, st->codec);
+    text_left(fb, MARGIN, 106, buf, TEXT_W, 3, GREY);
+}
+
+static void render_health(uint16_t *fb, const kvm_display_status_t *st)
+{
+    char buf[40];
+    const float ram =
+        st->psram_total_kb ? 1.0f - (float)st->psram_kb / (float)st->psram_total_kb : 0.0f;
+
+    header(fb, icon_health, "HEALTH");
+    snprintf(buf, sizeof(buf), "Temp  %d C", st->temp_c);
+    text_left(fb, MARGIN, 50, buf, TEXT_W, 2, WHITE);
+    bar(fb, 70, 14, st->temp_c / 90.0f, st->temp_c < 60 ? GREEN : st->temp_c < 75 ? AMBER : RED);
+    snprintf(buf, sizeof(buf), "RAM  %d%%", (int)(ram * 100 + 0.5f));
+    text_left(fb, MARGIN, 102, buf, TEXT_W, 2, WHITE);
+    bar(fb, 122, 14, ram, CYAN);
+}
+
+void st7789_ui_render(st7789_ui_t *ui, uint16_t *fb, const kvm_display_status_t *st)
+{
+    if (st->notice[0]) {
+        /* A notice arriving mid-splash ends the splash, as on the round panel. */
+        ui->splash = 0;
+        render_notice(fb, st);
+        return;
+    }
+    if (ui->splash > 0) {
+        render_splash(ui, fb, st);
+        ui->splash--;
+        return;
+    }
+
+    /* Green with a target signal, amber when linked without one, red with no network. */
+    background(fb, st->ip[0] ? (st->video_signal ? GREEN : AMBER) : RED);
+    switch (ui->screen) {
+    case 0:
+        render_network(fb, st);
+        break;
+    case 1:
+        render_video(fb, st);
+        break;
+    default:
+        render_health(fb, st);
+        break;
+    }
+    if (++ui->tick >= SCREEN_DWELL_TICKS) {
+        ui->tick = 0;
+        ui->screen = (uint8_t)((ui->screen + 1) % STATUS_SCREENS);
+    }
+}
diff --git a/components/kvm_display/drivers/st7789/st7789_ui.h b/components/kvm_display/drivers/st7789/st7789_ui.h
new file mode 100644
index 0000000..3db3d93
--- /dev/null
+++ b/components/kvm_display/drivers/st7789/st7789_ui.h
@@ -0,0 +1,34 @@
+/*
+ * SPDX-FileCopyrightText: 2026 ESP-KVM contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * The picture on a 320x170 landscape ST7789. Pixels only, no panel I/O, so that
+ * components/kvm_display/test can run it on a host and look at the result.
+ */
+#pragma once
+
+#include <stdint.h>
+
+#include "kvm_display_driver.h"
+
+#define ST7789_UI_W 320
+#define ST7789_UI_H 170
+#define ST7789_UI_FRAME 4 /* thickness of the status frame around the glass */
+
+#define ST7789_UI_SPLASH_TICKS 4 /* first half: version card, second half: logo */
+
+typedef struct {
+    uint8_t screen;
+    uint8_t tick;
+    uint8_t splash;
+} st7789_ui_t;
+
+/* RGB565, byte-swapped so the buffer can go straight to the panel. */
+static inline uint16_t st7789_ui_rgb(uint8_t r, uint8_t g, uint8_t b)
+{
+    const uint16_t v = (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+    return (uint16_t)((v >> 8) | (v << 8));
+}
+
+/* Draw one frame into @p fb (ST7789_UI_W * ST7789_UI_H pixels) and advance @p ui. */
+void st7789_ui_render(st7789_ui_t *ui, uint16_t *fb, const kvm_display_status_t *st);

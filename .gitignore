# python and editor droppings
__pycache__/
*.pyc

# KiCad per-user state and backups
*.kicad_prl
*-backups/
fp-info-cache
*.lck

# firmware: upstream clone, build output, images, secrets
off-the-shelf/firmware/espkvm/
espkvm/
build/
build.*/
*.elf
*.bin
*.map
secrets.h
**/firmware/logs/build_*
**/firmware/logs/*.log

# generated by tools/check.sh and atx/build_atx.sh. Only the routed sessions and design data are kept.
lay-board/out/*
!lay-board/out/final.ses
!lay-board/out/final_r3.ses
!lay-board/out/design.json
!lay-board/out/stock.json
!lay-board/out/verify.out
off-the-shelf/atx/out/*
off-the-shelf/atx/out.log
!off-the-shelf/atx/out/design.json
!off-the-shelf/atx/out/final.ses

# never commit: old packages, other people's archives, order and personal material
archive/
reference/
releases/
v1/
*.7z
ExoAnchor*.zip
*NANO*official*CAD*
MFKVM-r3-CAM*.zip
**/fab/
**/fab_new/
**/fab_r2/
**/fab_r3/
**/fab_r4/
off-the-shelf/fab_atx/
*JLC*screenshot*
*.env
.env*
